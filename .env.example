OPENAI_API_KEY=
# Production values are configured through Sites, never through browser inputs.
# AGENT_MODEL, IMAGE_MODEL, SKILL_FILES_JSON, ADMIN_EMAIL
# OPENAI_WEBHOOK_SECRET is optional and requires a publicly reachable signed callback.
# Railway runtime: use npm run start:railway; set OPENAI_API_KEY in Railway Variables.
# APP_ORIGIN=https://p-design.up.railway.app
# PORT=8787
# SKILL_FILES_JSON is optional; startup uploads complete skills when absent.
# Mount a Railway Volume to persist visitor projects and uploaded skill records.
# Optional Supabase database: set DATABASE_URL securely in Railway Variables.
# Use the Session pooler on port 5432 with sslmode=require; see docs/supabase.md.
# TUXU_DATA_DIR=/data
# DATABASE_CA_CERT is optional PEM for certificate verification.
